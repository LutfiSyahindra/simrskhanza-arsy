    .replaceAll("[\\u00A0\\u200B\\t]", " ")
    // Hapus baris kosong & whitespace di awal teks
    .replaceAll("(?m)^[\\s\\r\\n]+", "")
    // Hapus baris kosong & whitespace di akhir teks
    .replaceAll("(?m)[\\s\\r\\n]+$", "")
    // Hapus carriage return
    .replaceAll("\\r", "")
    // Hapus newline berlebih di akhir
    .replaceAll("\\n+$", "")
    // Hapus whitespace tersisa
    .trim()
)]]></textFieldExpression>
