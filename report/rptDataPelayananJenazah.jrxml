	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="tanggal1" class="java.lang.String"/>
	<parameter name="tanggal2" class="java.lang.String"/>
	<parameter name="parameter" class="java.lang.String"/>
	<queryString>
		<![CDATA[select pelayanan_jenazah.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,pelayanan_jenazah.tgl_kejadian,pelayanan_jenazah.jam_kejadian,
		concat(pasien.alamat,', ',kelurahan.nm_kel,', ',kecamatan.nm_kec,', ',kabupaten.nm_kab) as alamat,pasien.jk,reg_periksa.umurdaftar,reg_periksa.sttsumur,
		pelayanan_jenazah.rtl,pelayanan_jenazah.identifikasi_masalah,pelayanan_jenazah.tgl_lapor,pelayanan_jenazah.jam_lapor,pelayanan_jenazah.unit_terkait,pelayanan_jenazah.lokasi,
		reg_periksa.kd_pj,penjab.png_jawab,pelayanan_jenazah.disucikan
from pelayanan_jenazah inner join reg_periksa inner join pasien on 
pelayanan_jenazah.no_rawat=reg_periksa.no_rawat and reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
inner join kelurahan on pasien.kd_kel=kelurahan.kd_kel inner join kecamatan on pasien.kd_kec=kecamatan.kd_kec 
inner join kabupaten on pasien.kd_kab=kabupaten.kd_kab inner join penjab on penjab.kd_pj=reg_periksa.kd_pj where 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pelayanan_jenazah.no_rawat like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and reg_periksa.no_rkm_medis like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pasien.alamat like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pasien.jk like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pelayanan_jenazah.rtl like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pelayanan_jenazah.identifikasi_masalah like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pelayanan_jenazah.unit_terkait like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pelayanan_jenazah.lokasi like $P{parameter} or 
pelayanan_jenazah.tgl_kejadian between $P{tanggal1} and $P{tanggal2} 
and pasien.nm_pasien like $P{parameter} order by pelayanan_jenazah.tgl_kejadian]]>
	</queryString>
